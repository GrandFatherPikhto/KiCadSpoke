#: kicadspoke_cli.py:61
#, python-brace-format
msgid "Loading config: {config}"
msgstr "Загрузка конфига: {config}"

#: kicadspoke_cli.py:87
#, python-brace-format
msgid " (maybe you meant {suggestion!r}?)"
msgstr " (возможно, вы имели в виду {suggestion!r}?)"

#: kicadspoke_cli.py:88
#, python-brace-format
msgid ""
"  {name!r} — not found among rules, clone_placements, or "
"thermal_via_array{hint}"
msgstr ""
"  {name!r} — не найден среди rules, clone_placements или "
"thermal_via_array{hint}"

#: kicadspoke_cli.py:90
#, python-brace-format
msgid ""
"[error] --only: names not found:\n"
"{lines}\n"
"Available: {all}"
msgstr ""
"[ошибка] --only: имена не найдены:\n"
"{lines}\n"
"Доступны: {all}"

#: kicadspoke_cli.py:97
#, python-brace-format
msgid ""
"--only {requested}: rules={rules}, clone_placements={clones}, "
"thermal_via_array={thermal} (everything else is ignored in this run)"
msgstr ""
"--only {requested}: rules={rules}, clone_placements={clones}, "
"thermal_via_array={thermal} (всё остальное в этом прогоне игнорируется)"

#: kicadspoke_cli.py:102
msgid "yes"
msgstr "да"

#: kicadspoke_cli.py:102
msgid "no"
msgstr "нет"

#: kicadspoke_cli.py:106 kicadspoke_cli.py:206
#, python-brace-format
msgid "Connecting to KiCad (timeout {timeout} ms)"
msgstr "Подключение к KiCad (таймаут {timeout} мс)"

#: kicadspoke_cli.py:112
msgid "Planning placement..."
msgstr "Планирование расстановки..."

#: kicadspoke_cli.py:120
msgid "Moves:"
msgstr "Перемещения:"

#: kicadspoke_cli.py:122
#, python-brace-format
msgid "  {ref}: ({x:.3f}, {y:.3f}) mm, angle={angle:.1f}°"
msgstr "  {ref}: ({x:.3f}, {y:.3f}) мм, угол={angle:.1f}°"

#: kicadspoke_cli.py:124
msgid "Vias:"
msgstr "Виа:"

#: kicadspoke_cli.py:126
#, python-brace-format
msgid "  via for {owner}: ({x:.3f}, {y:.3f}) mm, net={net}"
msgstr "  via для {owner}: ({x:.3f}, {y:.3f}) мм, цепь={net}"

#: kicadspoke_cli.py:128
msgid "Tracks:"
msgstr "Треки:"

#: kicadspoke_cli.py:130
#, python-brace-format
msgid ""
"  track for {owner}: ({sx:.3f}, {sy:.3f}) -> ({ex:.3f}, {ey:.3f}) mm, "
"net={net}, width={w} mm"
msgstr ""
"  трек для {owner}: ({sx:.3f}, {sy:.3f}) -> ({ex:.3f}, {ey:.3f}) мм, "
"цепь={net}, ширина={w} мм"

#: kicadspoke_cli.py:133
msgid ""
"(thermal via keepout is computed based on CURRENT component positions, "
"not the target ones — may slightly differ from the real run)"
msgstr ""
"(keepout термовиа посчитан по ТЕКУЩИМ позициям компонентов, "
"не по целевым — может слегка отличаться от боевого прогона)"

#: kicadspoke_cli.py:135
msgid ""
"(track collisions with other copper/components are NOT checked by this "
"tool — rely on KiCad DRC after placement)"
msgstr ""
"(коллизии треков с чужой медью/компонентами НЕ проверяются этим "
"инструментом — полагаемся на DRC самого KiCad после расстановки)"

#: kicadspoke_cli.py:145
#, python-brace-format
msgid "Planned moves: {count}"
msgstr "Запланировано перемещений: {count}"

#: kicadspoke_cli.py:146
msgid "Applying moves..."
msgstr "Применение перемещений..."

#: kicadspoke_cli.py:153
#, python-brace-format
msgid "Failed to move: {refs}"
msgstr "Не удалось переместить: {refs}"

#: kicadspoke_cli.py:156
msgid "Reloading board data before planning vias..."
msgstr "Обновление данных платы перед планированием виа..."

#: kicadspoke_cli.py:162
#, python-brace-format
msgid ""
"Planned vias: {total}, actually to create (registry filtered already "
"correctly placed): {to_create}"
msgstr ""
"Запланировано виа: {total}, реально к созданию (реестр отсеял уже "
"стоящие правильно): {to_create}"

#: kicadspoke_cli.py:164
msgid "Applying vias..."
msgstr "Применение виа..."

#: kicadspoke_cli.py:167
#, python-brace-format
msgid "Failed to create vias near: {refs}"
msgstr "Не удалось создать виа рядом с: {refs}"

#: kicadspoke_cli.py:172
#, python-brace-format
msgid ""
"Planned tracks: {total}, actually to create (registry filtered already "
"correctly placed): {to_create}"
msgstr ""
"Запланировано треков: {total}, реально к созданию (реестр отсеял уже "
"стоящие правильно): {to_create}"

#: kicadspoke_cli.py:174
msgid "Applying tracks..."
msgstr "Применение треков..."

#: kicadspoke_cli.py:177
#, python-brace-format
msgid "Failed to create tracks near: {refs}"
msgstr "Не удалось создать треки рядом с: {refs}"

#: kicadspoke_cli.py:180
msgid "✅ All operations completed successfully"
msgstr "✅ Все операции выполнены успешно"

#: kicadspoke_cli.py:182
msgid "⚠️ Some operations failed – check the log."
msgstr "⚠️ Некоторые операции завершились с ошибками – проверьте лог."

#: kicadspoke_cli.py:192
#, python-brace-format
msgid "[error] profiles file {path!r} not found"
msgstr "[ошибка] файл профилей {path!r} не найден"

#: kicadspoke_cli.py:198
#, python-brace-format
msgid ""
"[error] profile {name!r} not found in {top_key!r} of file {path!r}. "
"Available: {avail}"
msgstr ""
"[ошибка] профиль {name!r} не найден в {top_key!r} файла {path!r}. "
"Доступны: {avail}"

#: kicadspoke_cli.py:215
msgid ""
"[error] --profile cannot be combined with --name/--output/--param/--net-"
"template/--net-template-role/--origin-by-*: either all from profile or "
"all as explicit flags, not mixed."
msgstr ""
"[ошибка] --profile нельзя сочетать с --name/--output/--param/--net-template/"
"--net-template-role/--origin-by-*: либо всё из профиля, либо всё явными "
"флагами, не вперемешку."

#: kicadspoke_cli.py:221 kicadspoke_cli.py:428
msgid "[error] --profile given without --profiles (profiles file)"
msgstr "[ошибка] --profile указан без --profiles (файла профилей)"

#: kicadspoke_cli.py:225 kicadspoke_cli.py:432
#, python-brace-format
msgid "[error] profile {profile!r} missing required field {field!r}"
msgstr "[ошибка] в профиле {profile!r} отсутствует обязательное поле {field!r}"

#: kicadspoke_cli.py:235
#, python-brace-format
msgid "Profile {profile!r} from {profiles}: name={name}, output={output}"
msgstr "Профиль {profile!r} из {profiles}: name={name}, output={output}"

#: kicadspoke_cli.py:241
msgid "[error] need --name and --output (or --profiles/--profile instead)"
msgstr "[ошибка] нужны --name и --output (или --profiles/--profile вместо них)"

#: kicadspoke_cli.py:245
#, python-brace-format
msgid "--param {item!r} — need format KEY=VALUE"
msgstr "--param {item!r} — нужен формат KEY=VALUE"

#: kicadspoke_cli.py:253
#, python-brace-format
msgid "--net-template {item!r} — need format LITERAL=PATTERN"
msgstr "--net-template {item!r} — нужен формат ЛИТЕРАЛ=ПАТТЕРН"

#: kicadspoke_cli.py:261
#, python-brace-format
msgid "--net-template-role {item!r} — need format ROLE=LITERAL"
msgstr "--net-template-role {item!r} — нужен формат РОЛЬ=ЛИТЕРАЛ"

#: kicadspoke_cli.py:270
msgid ""
"[error] --origin-by-component-pad without --origin-by-component-role — "
"you can only refine a pad for a role that you first specify"
msgstr ""
"[ошибка] --origin-by-component-pad без --origin-by-component-role — "
"уточнять пад можно только у роли, которую сначала надо указать"

#: kicadspoke_cli.py:288
#, python-brace-format
msgid "Template {name!r} already exists in {output} — will be overwritten"
msgstr "Шаблон {name!r} уже есть в {output} — будет перезаписан"

#: kicadspoke_cli.py:299
#, python-brace-format
msgid "✅ Template {name!r} written to {output}"
msgstr "✅ Шаблон {name!r} записан в {output}"

#: kicadspoke_cli.py:307
msgid "logs directory not found."
msgstr "Папка logs не найдена."

#: kicadspoke_cli.py:312
msgid "No operation files to undo."
msgstr "Нет файлов операций для отката."

#: kicadspoke_cli.py:316
#, python-brace-format
msgid "Undoing operation from {file}"
msgstr "Откат операции из {file}"

#: kicadspoke_cli.py:319
msgid "✅ Operation successfully undone."
msgstr "✅ Операция успешно откатана."

#: kicadspoke_cli.py:321
msgid "❌ Failed to undo operation."
msgstr "❌ Не удалось откатить операцию."

#: kicadspoke_cli.py:329
msgid "KiCad Decap Placer – capacitor placement (manual strategy)"
msgstr "KiCad Decap Placer – расстановка конденсаторов (ручная стратегия)"

#: kicadspoke_cli.py:330
msgid "Example: kicadspoke_cli.py config.yaml --dry-run"
msgstr "Пример: kicadspoke_cli.py config.yaml --dry-run"

#: kicadspoke_cli.py:332
msgid "Subcommand"
msgstr "Подкоманда"

#: kicadspoke_cli.py:334
msgid "Apply placement"
msgstr "Применить расстановку"

#: kicadspoke_cli.py:335
msgid "YAML configuration file"
msgstr "YAML конфигурационный файл"

#: kicadspoke_cli.py:336
msgid "Only print the plan, do not apply"
msgstr "Только распечатать план, не применять"

#: kicadspoke/diagnostics/diagnose_first_write_crash.py:276
#: kicadspoke/diagnostics/diagnostic_charset.py:71
#: kicadspoke/diagnostics/get_pad_bbox.py:28
#: kicadspoke/diagnostics/test_create_one_via.py:56
#: kicadspoke/diagnostics/test_flip_one_cap.py:58
#: kicadspoke/diagnostics/test_move_one_cap.py:55
#: kicadspoke/diagnostics/test_pad_mirror_convention.py:84
#: kicadspoke_cli.py:337 kicadspoke_cli.py:375
msgid "IPC timeout in ms"
msgstr "Таймаут IPC, мс"

#: kicadspoke_cli.py:338
msgid "Batch size for commits"
msgstr "Размер батча для коммитов"

#: kicadspoke/diagnostics/get_pad_bbox.py:29 kicadspoke_cli.py:339
#: kicadspoke_cli.py:349 kicadspoke_cli.py:365 kicadspoke_cli.py:376
msgid "Verbose output"
msgstr "Подробный вывод"

#: kicadspoke_cli.py:340 kicadspoke_cli.py:350 kicadspoke_cli.py:377
msgid "File to save logs"
msgstr "Файл для сохранения логов"

#: kicadspoke_cli.py:341
msgid "Disable collision checking"
msgstr "Отключить проверку коллизий"

#: kicadspoke_cli.py:342
msgid "Extra clearance for collision check in mm"
msgstr "Дополнительный зазор при проверке коллизий, мм"

#: kicadspoke_cli.py:344
msgid ""
"Process only rules/clone_placements/thermal_via_array with this name (can"
" be repeated). The name must be explicitly set in the YAML (see docs). "
"Everything else is ignored in this run."
msgstr ""
"Обработать только rules/clone_placements/thermal_via_array с этим именем "
"(можно повторять). Имя должно быть явно задано в YAML (см. документацию). "
"Всё остальное в этом прогоне игнорируется."

#: kicadspoke_cli.py:348
msgid "Undo last operation"
msgstr "Откатить последнюю операцию"

#: kicadspoke_cli.py:354
msgid "Snapshot a channel to YAML (file‑based cloner, no IPC)"
msgstr "Снимок канала в YAML (файловый клонер, без IPC)"

#: kicadspoke_cli.py:356
msgid "Path to .net file"
msgstr "Путь к .net-файлу"

#: kicadspoke_cli.py:357
msgid "Path to .kicad_pcb file"
msgstr "Путь к .kicad_pcb-файлу"

#: kicadspoke_cli.py:358
msgid "Channel name, e.g. Channel_0"
msgstr "Имя канала, например Channel_0"

#: kicadspoke_cli.py:359
msgid "YAML snapshot file"
msgstr "YAML-файл снимка"

#: kicadspoke_cli.py:361
msgid "YAML file with named profiles for clone-extract"
msgstr "YAML-файл с именованными профилями для clone-extract"

#: kicadspoke_cli.py:363
msgid ""
"Take net/pcb/channel/output from profile NAME in --profiles file (cannot "
"combine with explicit flags)"
msgstr ""
"Взять net/pcb/channel/output из профиля NAME в файле --profiles "
"(нельзя сочетать с явными флагами)"

#: kicadspoke_cli.py:367
msgid "Extract spoke template from current selection"
msgstr "Извлечь шаблон спицы из текущего выделения"

#: kicadspoke_cli.py:368
msgid "Template name (key in templates:)"
msgstr "Имя шаблона (ключ в templates:)"

#: kicadspoke_cli.py:369
msgid "Output YAML/JSON file"
msgstr "Выходной YAML/JSON-файл"

#: kicadspoke_cli.py:371
msgid "YAML file with named profiles for extract"
msgstr "YAML-файл с именованными профилями для extract"

#: kicadspoke_cli.py:373
msgid ""
"Take name/output/param/net-template/origin-by-* from profile NAME in "
"--profiles file (cannot combine with explicit flags)"
msgstr ""
"Взять name/output/param/net-template/origin-by-* из профиля NAME в файле "
"--profiles (нельзя сочетать с явными флагами)"

#: kicadspoke_cli.py:379
msgid ""
"Parameter for --net-template verification (e.g. channel=1); can be "
"repeated; not written to template, only round-trip check"
msgstr ""
"Параметр для проверки --net-template (например, channel=1); "
"можно повторять; в шаблон не пишется, только проверка round-trip"

#: kicadspoke_cli.py:382
#, python-brace-format
msgid ""
"Mapping real net -> pattern with {placeholder} (e.g. "
"'DAC1_DB1=DAC{channel}_DB1'); can be repeated; fills net_template for "
"roles and parametrizes via.net at extraction"
msgstr ""
"Карта реальная цепь -> паттерн с {placeholder} (например, "
"'DAC1_DB1=DAC{channel}_DB1'); можно повторять; заполняет net_template "
"ролей и параметризует via.net при извлечении"

#: kicadspoke_cli.py:386
msgid ""
"For components with multiple nets from --net-template on pads "
"(ferrite/inductor/fuse between two rails) – explicitly tells which net is"
" the role's net_template (e.g. 'PI_FILTER_FB=+5V_DIRTY'); without this "
"such roles get empty net_template and need manual edit. Fatal if the role"
" does not actually have that net on its pads, or if the literal is not "
"registered in --net-template/params."
msgstr ""
"Для компонентов с НЕСКОЛЬКИМИ цепями из --net-template на падах "
"(дроссель/феррит/предохранитель между двумя шинами) – явно указывает, "
"какая цепь является net_template этой роли (например, "
"'PI_FILTER_FB=+5V_DIRTY'); без этого такие роли получают пустой "
"net_template и требуют ручной правки. Фатал, если у роли на самом деле "
"нет такой цепи на падах, или литерал не зарегистрирован в "
"--net-template/params."

#: kicadspoke_cli.py:394
msgid ""
"Template origin — position of via on this net (instead of bbox); fatal if"
" no such via in selection or more than one"
msgstr ""
"Начало координат шаблона — позиция via на этой цепи (вместо bbox); "
"фатально, если такой via нет в выделении или их несколько"

#: kicadspoke_cli.py:397
msgid ""
"Template origin — position of component with this role (instead of bbox);"
" fatal if role not found in selection"
msgstr ""
"Начало координат шаблона — позиция компонента с этой ролью (вместо bbox); "
"фатально, если роль не найдена в выделении"

#: kicadspoke_cli.py:400
msgid ""
"Refine --origin-by-component-role: origin is the position of the specific"
" pad of that component, not its centre. Fatal without --origin-by-"
"component-role."
msgstr ""
"Уточнение --origin-by-component-role: начало координат — позиция "
"конкретного пада этого компонента, а не его центр. Фатально без "
"--origin-by-component-role."

#: kicadspoke_cli.py:425
msgid "[error] --profile cannot be combined with --net/--pcb/--channel/--output"
msgstr "[ошибка] --profile нельзя сочетать с --net/--pcb/--channel/--output"

#: kicadspoke_cli.py:437
msgid "[error] need --net/--pcb/--channel/--output (or --profiles/--profile)"
msgstr "[ошибка] нужны --net/--pcb/--channel/--output (или --profiles/--profile)"

#: kicadspoke_cli.py:442
#, python-brace-format
msgid "[{channel}] footprints: {fp}, segments: {seg}, vias: {vias} -> {output}"
msgstr "[{channel}] футпринтов: {fp}, сегментов: {seg}, виа: {vias} -> {output}"

#: kicadspoke_cli.py:451
#, python-brace-format
msgid "Error: {e}"
msgstr "Ошибка: {e}"

#: kicadspoke_cli.py:456
msgid ""
"KiCad is busy and cannot respond right now. Usually this means an "
"unfinished tool is active in the GUI (dimensioning, interactive routing, "
"move tool, etc.) — finish it (Esc or right-click -> Cancel) and run the "
"command again. The board was not modified."
msgstr ""
"KiCad занят и не может ответить на запрос прямо сейчас. Обычно это "
"означает, что в интерфейсе активен незавершённый инструмент "
"(простановка размеров, интерактивная трассировка, перемещение мышкой "
"и т.п.) — завершите его (Esc или клик правой кнопкой -> Cancel) и "
"запустите команду ещё раз. Плата не тронута."

#: kicadspoke_cli.py:462
#, python-brace-format
msgid "KiCad returned API error: {e}"
msgstr "KiCad вернул ошибку API: {e}"

#: kicadspoke_cli.py:465
msgid "Unexpected error"
msgstr "Неожиданная ошибка"

#: kicadspoke/exceptions.py:38
#, python-brace-format
msgid "  FATAL ERROR: {title}"
msgstr "  ФАТАЛЬНАЯ ОШИБКА: {title}"

#: kicadspoke/exceptions.py:44
msgid "Placement stopped, board not modified. Fix the config and run again."
msgstr "Расстановка остановлена, плата не тронута. Исправьте конфиг и запустите заново."

#: kicadspoke/net_resolution.py:34
#, python-brace-format
msgid "net {template!r} has a placeholder with no parameter"
msgstr "в цепи {template!r} есть плейсхолдер без параметра"

#: kicadspoke/net_resolution.py:35
#, python-brace-format
msgid ""
"missing parameter {param} — add it to params of this clone_placement, or "
"remove the placeholder from the template"
msgstr ""
"не хватает параметра {param} — добавьте его в params этого clone_placement, "
"или уберите плейсхолдер из шаблона"

#: kicadspoke/net_resolution.py:65
#, python-brace-format
msgid "--net-template for {literal!r} fails round‑trip check"
msgstr "--net-template для {literal!r} не проходит проверку round-trip"

#: kicadspoke/net_resolution.py:66
#, python-brace-format
msgid ""
"pattern {pattern!r} with params={params} resolves to {check!r}, not to "
"{literal!r} — typo in pattern or wrong parameter passed via --param"
msgstr ""
"паттерн {pattern!r} с params={params} резолвится в {check!r}, "
"а не в {literal!r} — опечатка в паттерне или не тот параметр "
"передан через --param"

#: kicadspoke/registry.py:93
#, python-brace-format
msgid ""
"Failed to read registry {path}: {type}: {e} — treating registry as empty "
"(all vias will be created anew)"
msgstr ""
"Не удалось прочитать реестр {path}: {type}: {e} — считаю реестр пустым "
"(все via будут созданы заново)"

#: kicadspoke/registry.py:126
#, python-brace-format
msgid ""
"Failed to read track registry {path}: {type}: {e} — treating registry as "
"empty (all tracks will be created anew)"
msgstr ""
"Не удалось прочитать реестр треков {path}: {type}: {e} — считаю реестр "
"пустым (все треки будут созданы заново)"

#: kicadspoke/registry.py:207
#, python-brace-format
msgid ""
"  {key}: registry has an entry (uuid {uuid}), but no such via is on the "
"board — registry is out of sync (manually deleted, Undo, PCB reloaded "
"from git, or previous run crashed between registry write and board "
"commit); recreating as if the entry never existed"
msgstr ""
"  {key}: в реестре есть запись (uuid {uuid}), но такой via на плате НЕТ — "
"реестр рассинхронизирован (удалили руками, Undo, PCB перечитан из git, "
"или прошлый прогон упал между записью в реестр и коммитом на плату); "
"пересоздаю, как будто записи не было"

#: kicadspoke/registry.py:218
#, python-brace-format
msgid ""
"  {key}: already correctly placed (checked against live via {uuid}), "
"skipped"
msgstr ""
"  {key}: уже стоит правильно (проверено по живой via {uuid}), пропуск"

#: kicadspoke/registry.py:223
#, python-brace-format
msgid ""
"  {key}: position/parameters changed, deleting old via ({uuid}) and "
"creating a new one"
msgstr ""
